* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
# Data fixtures keep their exact bytes (BOM, CRLF) because tests depend on them.
examples/**/*.csv -text
tests/fixtures/** -text
tests/cases/data/** -text
# Fuzzer-found inputs keep their exact bytes (they contain CR).
crates/okrun/tests/lexer_regressions/** -text

# Lexer error cases keep their exact bytes (control characters, lone CR).
tests/cases/err_source_*.ok -text
