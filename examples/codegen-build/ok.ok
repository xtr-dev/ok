import "ok/_codegen.ok"   # rust_struct(schema)

# Generate Rust types from the JSON schemas
task gen sources ["schema/*.json", "ok/_codegen.ok"] outputs ["src/gen.rs"] {
  let structs = glob("schema/*.json") | map(f => rust_struct(read(f)))
  write("// Generated by `ok gen`. Do not edit.\n\n" + join(structs, "\n"), "src/gen.rs")
}

# Build the service
task build(--release: bool) needs [gen] {
  run cargo build {...if release { ["--release"] } else { [] }}
}

# Run the tests
task test needs [gen] {
  run cargo test
}

# Check formatting and lints
task lint needs [gen] {
  run cargo fmt --check
  run cargo clippy -- -D warnings
}

# Remove build output and generated code
task clean {
  remove("target")
  remove("src/gen.rs")
}
