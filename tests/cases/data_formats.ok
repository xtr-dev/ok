# JSON, TOML, YAML, .env, JSON Lines, text and bytes.
let pkg = read("data/package.json")
print(pkg.name, pkg.version, pkg.scripts, pkg.private, type(pkg.big))
let cfg = read("data/config.toml")
print(cfg.title, cfg.server.port, cfg.server.hosts, cfg.users[0], type(cfg.released), cfg.day)
let yaml = read("data/settings.yaml")
print(yaml)
let env_file = read("data/.env")
print(env_file)
let events = read("data/events.jsonl")
print(len(events), events | map(.type))
print(read("data/app.log") | lines | count)
print(len(read("data/package.json", "bytes")))

print(to({name: "ok", tags: ["a"], n: 1.5, none: null}, "json"))
print(to({name: "ok", tags: ["a"]}, "json", compact: true))
print(to({title: "x", server: {port: 80}}, "toml"))
print(to({name: "ok", list: [1, "two"], nested: {a: true}}, "yaml"))
print(to({A: "1", B: "has space"}, "env"))
print(to([{a: 1}, {a: 2}], "jsonl"))
print(to(["one", "two"], "lines"))
print(parse("a: [1, 2]", "yaml"), parse("x = 1", "toml"), parse("[1, 2.5]", "json"))
print(parse("a: 1\n---\nb: 2\n", "yaml_all"))
write({a: 1}, "out/data.yml")
write("A=1\n", "out/.env.test", "text")
print(read("out/data.yml"), read("out/.env.test"))
write("first\n", "out/log.txt")
write(["second", "third"], "out/log.txt", append: true)
print(read("out/log.txt") | lines)
