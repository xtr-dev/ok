# A failure on the left of `run a | run b` is raised once b has finished,
# like a shell with `set -o pipefail`; the leftmost failure wins (SPEC.md 9.7).
let a = try { let r = run ok-fixture exit 3 | run ok-fixture cat } catch e { "{e.kind} {e.code} {e.cmd}" }
print(a)
# `!` applies to the command it is written on.
let r = run! ok-fixture exit 4 | run ok-fixture upper
print(r.code, r.ok)
let b = try { let x = run ok-fixture exit 4 | run ok-fixture exit 5 | lines } catch e { e.code }
print(b)
let c = run ok-fixture lines 2 | run! ok-fixture exit 5
print(c.code)
print(run ok-fixture lines 3 | run ok-fixture upper | lines)
run ok-fixture exit 6 | run ok-fixture cat
print("not reached")
