# Environment, time, hashing (SPEC.md 12.3, 12.7, 12.9). TZ is UTC in tests.
print(env.OK_TEST_VAR, env.get("OK_SURELY_UNSET", "fallback"), env.has("OK_TEST_VAR"), env.has("OK_SURELY_UNSET"))
env.set("OK_NEW", "value")
print(env.OK_NEW, env.all().OK_NEW)
env.remove("OK_NEW")
print(env.get("OK_NEW"))
print(os.name in ["linux", "macos", "windows"] or true, type(os.arch), which("ok-fixture") != null, which("no-such-program-x"))
let t = time("2026-11-24T10:30:15Z")
print(t, t.year, t.month, t.day, t.hour, t.minute, t.second, t.unix)
print(t.format("%Y-%m-%d %H:%M:%S"), t.format("%a %b %d", utc: true))
print(time("2026-11-24") + 36h, (time("2026-11-25T00:00:00Z") - t), t - 1d < t)
print(duration("1h30m"), duration("250ms") * 4, type(now()), now() > t)
sleep(1ms)
let d = tempdir()
write("hello\n", d / "f.txt")
print(hash(d / "f.txt"), hash(d / "f.txt", "md5"), hash(bytes("abc"), "sha1"))
print(hash(bytes(""), "sha512").len())
