# Files and paths (SPEC.md 12.1, 12.2).
let d = tempdir()
write("hello\n", d / "a.txt")
write("x", d / "sub/deep/b.md")
write("y", d / ".hidden")
touch(d / "c.txt")
print(list_dir(d) | map(.name))
print(glob("*.txt", root: d) | map(p => p.relative_to(d)))
print(glob("**/*.md", root: d) | map(p => p.relative_to(d)))
print(glob("**/*", root: d) | map(p => str(p.relative_to(d))))
print(glob("**/*", root: d, hidden: true, exclude: ["sub"]) | map(p => str(p.relative_to(d))))
print(glob(".*", root: d) | map(.name))
print(exists(d / "a.txt"), exists(d / "nope"), is_file(d / "a.txt"), is_dir(d / "sub"))
let st = stat(d / "a.txt")
print(st.size, st.is_file, st.is_dir, type(st.modified))
copy(d / "a.txt", d / "copy/a.txt")
copy(d / "sub", d / "sub2")
move(d / "c.txt", d / "moved/c.txt")
print(exists(d / "copy/a.txt"), exists(d / "sub2/deep/b.md"), exists(d / "c.txt"), exists(d / "moved/c.txt"))
print(remove(d / "sub2"), remove(d / "sub2"), exists(d / "sub2"))
print(mkdir(d / "made/here").name, is_dir(d / "made/here"))
chmod(d / "a.txt", 0o644)
let t = tempfile(ext: "json")
print(t.ext, exists(t))
let p = path("build/out/app.tar.gz")
print(p.name, p.stem, p.ext, p.parent, p.with_ext("zip"), p.parts(), p.is_abs())
print(path("a/b").relative_to("a"), path("/srv/app/x").relative_to(path("/srv")), path("x").abs().is_abs())
print(type(home), type(cwd), type(script_dir), script_dir.name, type(invocation_dir))
print(path("dist") / "x" / "../y.txt", path("rel") / path("/abs"))
