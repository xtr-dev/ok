# Numbers, durations and operators (SPEC.md 5.5, 5.9).
print(7 / 2, 6 / 3, 7 % 3, -7 % 3, 2 * 3 + 4, 2 * (3 + 4))
print(1 + 2.5, 10 - 0.5, 3 * 1.5)
print(1 == 1.0, 1 != 2, "a" < "b", [1, 2] < [1, 3], false < true)
print(floor(7 / 2), ceil(7 / 2), round(2.5), round(-2.5), int(3.9), int(-3.9))
print(1h + 30m, 2m - 30s, 1.5s * 2, 3 * 20s, 1m / 4, 1h / 30m)
print((1h30m).seconds, (1500ms).millis)
print(not true, true and false, true or false)
print(2 in [1, 2, 3], "b" in {a: 1, b: 2}, "ell" in "hello", 4 not in [1, 2])
print([1, 2] + [3], "con" + "cat")
print(int("42"), float("2.5"), int(true), str(12) + "!")
