# Build and admin tasks for the ok repository itself.
#
# Run `ok` here to list them. Each task's comment shows the cargo command it
# runs (CLAUDE.md lists them too).

requires "0.1"

# Build a debug binary (cargo build)
task build(--release: bool) {
  run cargo build --workspace {...if release { ["--release"] } else { [] }}
}

# Run all tests (cargo test --workspace)
task test {
  run cargo test --workspace
}

# Regenerate golden test expectations; review the diff before committing (OK_BLESS=1 cargo test --test golden)
task bless {
  run cargo test --test golden with {env: {OK_BLESS: "1"}}
  run git diff --stat -- tests/cases
}

# Fuzz every target for a while on this machine (CI only runs 45 seconds per target).
# Each target runs in --forks processes; inputs are kept in fuzz/corpus/ between
# runs, and crashes land in fuzz/artifacts/TARGET/ with a stop.
task fuzz(--minutes: int = 30, --forks: int = 4, --target: string? = null) {
  let all = ["lex", "parse", "fmt", "eval", "data", "archive"]
  let targets = if target == null { all } else { [target] }
  for t in targets {
    # eval's sandbox keeps every allocation far below 512 MiB; the data
    # targets may use their 1 GiB limits.
    let malloc = if t == "eval" { 512 } else { 4096 }
    run cargo +nightly fuzz run {t} -- -max_total_time={minutes * 60} -fork={forks} -timeout=10 -rss_limit_mb=4096 -malloc_limit_mb={malloc} -close_fd_mask=3
  }
}

# Format the code (cargo fmt --all)
task fmt {
  run cargo fmt --all
}

# Check formatting and lints like CI does (cargo fmt --all --check; cargo clippy ... -D warnings)
task lint {
  run cargo fmt --all --check
  run cargo clippy --workspace --all-targets -- -D warnings
}

# Check dependency licences, advisories and sources (cargo deny check)
task deny {
  run cargo deny check
}

# Regenerate THIRD_PARTY.md (cargo about generate -m crates/okrun/Cargo.toml about.hbs > THIRD_PARTY.md)
task third-party {
  run cargo about generate -m crates/okrun/Cargo.toml about.hbs > THIRD_PARTY.md
}

# Everything CI checks (lint, test and deny run in parallel)
task ci needs [lint, test, deny] {
  print("all checks passed")
}
